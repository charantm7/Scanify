# supabase public access key
NEXT_PUBLIC_SUPABASE_URL=https://.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1Ni

# supabase service role key 
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni

# Domain Details
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# Host-based routing (see src/lib/domains.ts).
# Apex domain, no protocol and no leading dot. The proxy derives
# dashboard.<domain>, menu.<domain> and console.<domain> from it.
NEXT_PUBLIC_ROOT_DOMAIN=scanify.co.in

# Cookie domain shared across those subdomains, WITH the leading dot.
# Required in production: without it the session cookie written at sign-in on
# one subdomain is not readable on another, so auth silently breaks.
# Leave EMPTY in local development so cookies stay host-only on localhost.
NEXT_PUBLIC_COOKIE_DOMAIN=.scanify.co.in

# App redirects
NEXT_PUBLIC_SIGNUP_EMAIL_REDIRECT_TO=auth-callback?type=signup
NEXT_PUBLIC_PASSWORD_RESET_EMAIL_REDIRECT_TO=auth-callback?type=recovery
NEXT_PUBLIC_OAUTH_EMAIL_REDIRECT_TO=auth-callback?type=oauth
NEXT_PUBLIC_COOLDOWN_SECONDS=60

# payment
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=NVMBq7j
RAZORPAY_WEBHOOK_SECRET=qRf4z